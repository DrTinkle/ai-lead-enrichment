"""
NewsAPI collector.
Returns up to 5 recent articles for the company domain/name.
Skips gracefully if NEWS_API_KEY is not set.
"""
import logging
from typing import Optional

import requests

from app.config import settings

logger = logging.getLogger(__name__)

_BASE = "https://newsapi.org/v2/everything"
TIMEOUT = 8


def fetch_news(company_name: str, domain: str) -> Optional[dict]:
    if not settings.NEWS_API_KEY:
        logger.info("NewsAPI key not set — skipping")
        return None

    # prefer company name; fall back to domain root
    query = company_name if company_name and company_name != domain else domain.split(".")[0]

    params = {
        "q": f'"{query}"',
        "language": "en",
        "sortBy": "publishedAt",
        "pageSize": 5,
        "apiKey": settings.NEWS_API_KEY,
    }

    try:
        resp = requests.get(_BASE, params=params, timeout=TIMEOUT)
    except requests.RequestException as e:
        logger.warning(f"NewsAPI request failed: {e}")
        return None

    if resp.status_code != 200:
        logger.warning(f"NewsAPI returned {resp.status_code}")
        return None

    data = resp.json()
    articles = data.get("articles", [])

    if not articles:
        return None

    parsed = []
    for a in articles:
        parsed.append({
            "title":       a.get("title"),
            "source":      a.get("source", {}).get("name"),
            "published_at": a.get("publishedAt", "")[:10],  # date only
            "url":         a.get("url"),
            "description": a.get("description"),
        })

    return {"articles": parsed, "total": data.get("totalResults", 0)}
