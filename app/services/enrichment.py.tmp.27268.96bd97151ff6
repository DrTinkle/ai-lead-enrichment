import json
import logging

from app.models.company import Company
from app.models.enrichment_result import EnrichmentResult
from app.services.data_sources import (
    fetch_company_from_abstractapi,
    fetch_company_site_signal,
)
from app.services.news import fetch_news
from app.services.funding import fetch_funding
from app.services.jobs import fetch_job_postings
from app.services.techstack import fetch_techstack
from app.services.github import fetch_github
from app.services.llm import analyze_company
from app.services.cache import load_from_cache, save_to_cache
from app.utils.cleaners import normalize_domain, normalize_industry

logger = logging.getLogger(__name__)


def _extract_name_from_title(title: str | None, domain: str) -> str | None:
    """
    Turn a page <title> into a clean company name.
    Strips common suffixes like " | Home", " - Official Site", "™" etc.
    Returns None if nothing better than the domain can be extracted.
    """
    if not title:
        return None
    import re
    # drop anything after common separators
    name = re.split(r"\s*[\|–—\-]\s*", title)[0].strip()
    # drop trailing trademark/registration symbols
    name = re.sub(r"[™®©]", "", name).strip()
    # if the result is suspiciously short or just the domain, skip
    if len(name) < 2 or name.lower() in {domain.lower(), domain.split(".")[0].lower()}:
        return None
    return name


def build_company_object(domain: str, api_data: dict | None, site_signal: dict | None):
    """Build Company model from collected raw data. Called by the UI pipeline."""
    name = domain; industry = None; size_estimate = None; location = None
    if api_data:
        name          = api_data.get("name") or name
        industry      = normalize_industry(api_data.get("industry"))
        size_estimate = api_data.get("employees_range")
        location      = api_data.get("country")

    raw_summary = ""; homepage_html = ""
    homepage_title = None
    if site_signal:
        chunks = []
        for p in site_signal.get("pages", []):
            chunks.append(
                f"[{p.get('label')}]\nTitle: {p.get('title')}\n"
                f"Description: {p.get('meta_description')}\nText: {p.get('text')}\n"
            )
            if p.get("label") == "homepage":
                homepage_html  = p.get("raw_html", "")
                homepage_title = p.get("title")
        raw_summary = "\n\n".join(chunks).strip()

    # If AbstractAPI returned nothing useful for the name, fall back to page title
    if name == domain or not name:
        extracted = _extract_name_from_title(homepage_title, domain)
        if extracted:
            name = extracted
            logger.info(f"Company name extracted from page title: {name!r}")

    return (
        Company(name=name, website=domain, industry=industry,
                size_estimate=size_estimate, location=location,
                raw_summary=raw_summary or "No website data available."),
        homepage_html,
    )


def parse_llm_result(ai_raw: str) -> dict | None:
    cleaned = ai_raw.strip()
    if cleaned.startswith("```"):
        cleaned = cleaned.split("```")[1]
    cleaned = cleaned.strip()
    ai_data    = json.loads(cleaned)
    enrichment = EnrichmentResult(**ai_data)
    return enrichment.model_dump()


def enrich_company(input_value: str) -> dict:
    domain = normalize_domain(input_value)

    cached = load_from_cache(domain)
    if cached:
        logger.info(f"Cache hit for {domain}")
        return cached

    logger.info(f"Cache miss for {domain} — running full pipeline")

    # ── 1. Structured company identity ───────────────────────────────────────
    api_data = fetch_company_from_abstractapi(domain)

    name          = domain
    industry      = None
    size_estimate = None
    location      = None

    if api_data:
        name          = api_data.get("name") or name
        industry      = normalize_industry(api_data.get("industry"))
        size_estimate = api_data.get("employees_range")
        location      = api_data.get("country")

    # ── 2. Website scrape ────────────────────────────────────────────────────
    site_signal = fetch_company_site_signal(domain)

    raw_summary = ""
    homepage_html = ""

    homepage_title = None
    if site_signal:
        pages = site_signal.get("pages", [])
        chunks = []
        for p in pages:
            chunks.append(
                f"[{p.get('label')}]\n"
                f"Title: {p.get('title')}\n"
                f"Description: {p.get('meta_description')}\n"
                f"Text: {p.get('text')}\n"
            )
            if p.get("label") == "homepage":
                homepage_html  = p.get("raw_html", "")
                homepage_title = p.get("title")
        raw_summary = "\n\n".join(chunks).strip()

    if not raw_summary:
        raw_summary = "No website data available."

    # Fall back to page title if AbstractAPI returned no name
    if name == domain or not name:
        extracted = _extract_name_from_title(homepage_title, domain)
        if extracted:
            name = extracted
            logger.info(f"Company name extracted from page title: {name!r}")

    company = Company(
        name=name,
        website=domain,
        industry=industry,
        size_estimate=size_estimate,
        location=location,
        raw_summary=raw_summary,
    )

    # ── 3. Free signal collectors ─────────────────────────────────────────────
    logger.info(f"Fetching signals for {domain}")

    news      = fetch_news(name, domain)
    funding   = fetch_funding(
        company_name=name,
        domain=domain,
        news_articles=[a for a in (news or {}).get("articles", [])],
    )
    jobs      = fetch_job_postings(name, domain)
    techstack = fetch_techstack(domain, existing_html=homepage_html or None)
    github    = fetch_github(name, domain)

    logger.info(
        f"Signals — news:{news is not None} funding:{funding is not None} "
        f"jobs:{jobs is not None} tech:{techstack is not None} github:{github is not None}"
    )

    # ── 4. LLM analysis ──────────────────────────────────────────────────────
    analysis = None
    try:
        ai_raw = analyze_company(
            company_data=company.model_dump(),
            funding=funding,
            jobs=jobs,
            news=news,
            techstack=techstack,
            github=github,
        )

        cleaned = ai_raw.strip()
        if cleaned.startswith("```"):
            cleaned = cleaned.split("```")[1]
        cleaned = cleaned.strip()

        ai_data    = json.loads(cleaned)
        enrichment = EnrichmentResult(**ai_data)
        analysis   = enrichment.model_dump()

    except Exception as e:
        logger.error(f"LLM parsing failed for {domain}: {e}")

    result = {
        "company":   company.model_dump(),
        "analysis":  analysis,
        "funding":   funding,
        "jobs":      jobs,
        "news":      news,
        "techstack": techstack,
        "github":    github,
    }

    if analysis:
        save_to_cache(domain, result)
        logger.info(f"Saved to cache for {domain}")

    return result
