from pydantic import BaseModel, Field
from typing import List, Optional


class EnrichmentResult(BaseModel):
    # Core classification
    summary:               str
    sector_classification: str
    maturity_stage:        str
    acquisition_fit_score: int
    growth_signal:         str = "unknown"
    tech_assessment:       str = "unknown"

    # Flags
    risk_flags:       List[str] = Field(default_factory=list)
    positive_signals: List[str] = Field(default_factory=list)

    # Narrative sections — analyst-style prose per signal area
    funding_outlook:  Optional[str] = None   # funding trajectory & financial health
    hiring_health:    Optional[str] = None   # what hiring patterns reveal
    tech_maturity:    Optional[str] = None   # stack assessment & integration risk
    market_position:  Optional[str] = None   # competitive standing & product signals

    # Score rationale
    reasoning: str
